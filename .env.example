# MOMEN.POTRAIT STUDIO — ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for local development

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Public Key (Safe for browser use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (SERVER ONLY — NEVER expose to browser)
# Used for backend administrator functions and initial setup
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Optional Studio Contact Default
NEXT_PUBLIC_STUDIO_WHATSAPP=6281234567890
